{
  "Freshdesk": {
    "ApiKey": "",
    "BaseUrl": "https://your-domain.freshdesk.com/api"
  },
  "Proffix": {
    "BaseUrl": "https://your-proffix-host",
    "User": "",
    "Password": "",
    "Database": "",
    "WriteValidationResults": false
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "console": {
        "type": "Console",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "console"
      }
    ]
  }
}
